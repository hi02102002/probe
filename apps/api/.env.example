APP_NAME=Webhook Debugger
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webhook_debugger
APP_NAME=Probe
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/probe
BETTER_AUTH_URL=http://localhost:3001
AUTH_COOKIE_DOMAIN=
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
WEB_URL=http://localhost:3000
SERVER_URL=http://localhost:3001
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PORT=3001

# Redis (realtime ingest pub/sub)
REDIS_URL=redis://localhost:6379

# Retention (days before webhook requests, replay and forward logs are purged; 0 = keep forever)
RETENTION_DAYS=30
