{
  "name": "@repo/api",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "imports": {
    "#/*": "./src/*"
  },
  "main": "dist/index.js",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env --env-file-if-exists=.env src/index.ts",
    "email:dev": "email dev --dir src/emails --port 3002",
    "format": "eslint . --fix",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@orpc/server": "^1.14.12",
    "@repo/api-contracts": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/env": "workspace:*",
    "@repo/utils": "workspace:*",
    "evlog": "^2.24.0",
    "hono": "^4.12.32",
    "react": "^19.2.0",
    "react-email": "^6.9.3",
    "resend": "^6.25.0"
  },
  "devDependencies": {
    "@react-email/ui": "^6.9.3",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "eslint": "^10.4.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2"
  }
}
