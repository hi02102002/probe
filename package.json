{
  "name": "probe",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:migrate:prod": "pnpm --filter @repo/db db:migrate:prod",
    "db:push": "pnpm --filter @repo/db db:push",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "dev": "turbo run dev",
    "email:dev": "pnpm --filter @repo/api email:dev",
    "format": "eslint . --fix",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "turbo run test",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "eslint": "^10.4.0",
    "react-doctor": "^0.9.14",
    "turbo": "^2.10.7",
    "typescript": "^6.0.2"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2"
    }
  }
}
