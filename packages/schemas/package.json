{
  "name": "@repo/schemas",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./dashboard": {
      "types": "./src/dashboard.ts",
      "development": "./src/dashboard.ts",
      "import": "./dist/dashboard.js"
    },
    "./endpoint": {
      "types": "./src/endpoint.ts",
      "development": "./src/endpoint.ts",
      "import": "./dist/endpoint.js"
    },
    "./endpoint-rule": {
      "types": "./src/endpoint-rule.ts",
      "development": "./src/endpoint-rule.ts",
      "import": "./dist/endpoint-rule.js"
    },
    "./pagination": {
      "types": "./src/pagination.ts",
      "development": "./src/pagination.ts",
      "import": "./dist/pagination.js"
    },
    "./wh-forward": {
      "types": "./src/wh-forward.ts",
      "development": "./src/wh-forward.ts",
      "import": "./dist/wh-forward.js"
    },
    "./wh-replay": {
      "types": "./src/wh-replay.ts",
      "development": "./src/wh-replay.ts",
      "import": "./dist/wh-replay.js"
    },
    "./wh-request": {
      "types": "./src/wh-request.ts",
      "development": "./src/wh-request.ts",
      "import": "./dist/wh-request.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "format": "eslint . --fix",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "eslint": "^10.4.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.2"
  }
}
