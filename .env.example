# ==========================================
# Probe Monorepo Environment Configuration
# ==========================================

# Core Application URLs
APP_NAME=Probe
PORT=3001
SERVER_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/probe

# Authentication (Better Auth)
AUTH_COOKIE_DOMAIN=
BETTER_AUTH_SECRET=replace-with-at-least-32-characters-secret

# OAuth Providers (Optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional Email / Resend (Optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
