# ==========================================
# Probe Monorepo Environment Configuration
# ==========================================

# Core Application URLs
APP_NAME=Probe
PORT=3001
SERVER_URL=http://localhost:3001 # Production: https://probe-api.monobase.io.vn
WEB_URL=http://localhost:3000 # Production: https://probe.monobase.io.vn

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/probe

# Redis (realtime ingest pub/sub)
REDIS_URL=redis://localhost:6379

# Retention (days before webhook requests, replay and forward logs are purged; 0 = keep forever)
RETENTION_DAYS=30

# Authentication (Better Auth)
AUTH_COOKIE_DOMAIN= # Production: .monobase.io.vn
BETTER_AUTH_SECRET=replace-with-at-least-32-characters-secret

# OAuth Providers (Optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional Email / Resend (Optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Billing / Polar (Optional — billing features stay disabled when unset)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# sandbox | production
POLAR_SERVER=sandbox
# Polar product id for the Premium plan (enables the pro checkout)
POLAR_PREMIUM_PRODUCT_ID=
